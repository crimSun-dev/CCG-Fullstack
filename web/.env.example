# Postgres for this site only. Production is the Neon project `ccg-public`, never the office hub.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ccg_public"

# Separate throwaway database for `pnpm test` and `pnpm test:e2e`. Tests truncate lead tables here.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ccg_public_test"

# Where lead notices go. The server refuses to start without it.
LEAD_TO_EMAIL="gm@example.com"

# Salt for SHA-256 of the visitor IP. Raw IPs are never stored.
LEAD_IP_SALT="change-me-to-a-long-random-string"

# Resend. Required in production. Without it in dev, lead notices are written to the server log.
RESEND_API_KEY=""
LEAD_FROM_EMAIL="CCG Website <onboarding@resend.dev>"

# Optional guard: if set, boot is refused when DATABASE_URL points at this host (the hub's Neon host).
HUB_DATABASE_HOST=""

# Virtual office wall. A different database from DATABASE_URL. Without these, /office still
# opens for staff and the board API answers 503.
# OFFICE_DATABASE_URL="postgresql://..."
# HUB_COMPANY_SLUG="kmk"

# Optional. Google OpenID Connect sign-in for existing staff rows. Leave blank to offer email and
# password only. Authorized redirect URI: <site origin>/login/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Canonical public origin for links in account email (password reset, email change).
# Without it the origin comes from the request's forwarded Host header.
PUBLIC_SITE_URL=""

# CK Virtual Lab for STAFF, EDITOR and ADMIN. This site serves it at /lab from ../lab when
# LAB_DATABASE_URL is set: the lab's own Neon database (never DATABASE_URL), migrated at build.
# The secret signs the hand-off into the lab (32+ chars): openssl rand -base64 48
# LAB_URL only when the lab runs somewhere else instead; it wins over /lab.
LAB_ASSERTION_SECRET=""
LAB_DATABASE_URL=""
LAB_COMPANY_SLUG="kmk"
LAB_URL=""
