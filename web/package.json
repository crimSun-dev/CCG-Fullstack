{
  "name": "ccg-public-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "pnpm install --config.node-linker=hoisted --frozen-lockfile && node scripts/assert-hoisted.mjs && prisma generate && node scripts/migrate.mjs && tsx scripts/seed-if-empty.ts && next build --webpack && node scripts/bind-all-interfaces.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "prisma": "prisma",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:reset": "prisma migrate reset --force && prisma db seed",
    "db:seed": "prisma db seed",
    "admin:create": "tsx scripts/create-admin.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "playwright test",
    "check:prisma-pin": "node scripts/check-prisma-pin.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.0",
    "@prisma/adapter-neon": "7.10.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "3.0.3",
    "next": "16.4.2",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "resend": "6.34.1",
    "three": "0.180.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/three": "0.180.0",
    "dotenv": "18.0.8",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@prisma/engines", "prisma", "esbuild"]
  }
}
